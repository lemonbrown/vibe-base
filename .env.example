# --- Vibe Base control-plane configuration ---
# Copy to .env and fill in. APPS_DOMAIN and CONTROL_PLANE_DOMAIN should share a
# parent so the session cookie can cover both (COOKIE_DOMAIN).

# Wildcard domain apps are served under (DNS: *.apps.example.com -> this VPS).
APPS_DOMAIN=apps.example.com
# Where the portal + login + forward-auth live (DNS: this -> this VPS).
CONTROL_PLANE_DOMAIN=vibe.example.com
# Shared parent so one session cookie covers the portal and every app.
COOKIE_DOMAIN=.example.com

# TLS issuance: "acme" for real certs on a real domain, or "internal" for
# self-signed certs (local dev with e.g. *.localtest.me).
TLS_MODE=acme

# The single platform owner.
OWNER_EMAIL=you@example.com
# Bearer token the `vibe` CLI uses (also the browser password if OWNER_PASSWORD is unset).
OWNER_TOKEN=change-me-long-random-token
# Optional: separate browser password for the owner.
OWNER_PASSWORD=
# Secret used to sign session cookies.
SESSION_SECRET=change-me-another-long-random-secret

# Container registry the VPS pulls app images from (GitHub Actions builds + pushes here).
# Leave GHCR_TOKEN blank for public images only; set it (read:packages) to pull private ones.
REGISTRY_HOST=ghcr.io
GHCR_USERNAME=your-github-username
GHCR_TOKEN=

# GitHub integration: PAT with repo + read/write:packages. Empty disables repo
# creation and deployment-status mirroring (registry deploys still work).
GITHUB_TOKEN=
# Owner new repos are created under. Empty = the token's own user account.
GITHUB_DEFAULT_OWNER=
# Set true if GITHUB_DEFAULT_OWNER is an organization (creates repos under /orgs).
GITHUB_OWNER_IS_ORG=false

# Platform email (apps with capabilities.email get this injected as env).
# Two transports; the control plane prefers Gmail API when its creds are set.
#
# Option A — Gmail API (HTTPS, port 443): works even where outbound SMTP is
# blocked (DigitalOcean blocks 25/465/587 by default). Recommended. See the
# Gmail API setup steps in the README to obtain a refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=you@gmail.com
#
# Option B — SMTP (ports 587/465). Personal Gmail needs an App Password
# (2-Step Verification on). Only works if outbound SMTP isn't blocked.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=you@gmail.com
SMTP_SECURE=false

# Postgres + MinIO.
POSTGRES_PASSWORD=change-me-db-password
MINIO_ROOT_USER=vibe
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_PUBLIC_ENDPOINT=https://storage.example.com
